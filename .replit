modules = ["nodejs-24"]
[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Expo"

[[workflows.workflow]]
name = "Start Expo"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx expo start --tunnel"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 8081
externalPort = 80
