# Server-only RevenueCat API v1 SECRET key, from the same project as the mobile SDK.
# Never prefix this with EXPO_PUBLIC_ or commit a populated value.
REVENUECAT_SECRET_API_KEY=

# Optional comma-separated backend account IDs reserved for Sandbox/TestFlight tests.
# Empty by default: a sandbox transaction must not unlock production accounts.
# Prefer an isolated test backend. Never enable this for all accounts.
REVENUECAT_SANDBOX_USER_IDS=

# Existing deployment variables (configure in the host's secret/environment UI).
SESSION_SECRET=
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
