# Copy this file to .env and set your backend URL
# For Replit: find your dev domain in the workspace header (e.g. https://your-repl.replit.dev)
EXPO_PUBLIC_API_BASE_URL=https://your-repl.replit.dev

# Optional native purchases. Leave empty to ship the free experience first.
# RevenueCat PUBLIC platform SDK keys only; never put an App Store private key here.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Published privacy policy URL required before the purchase button is enabled.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
