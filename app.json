{
  "expo": {
    "name": "PigeonSub",
    "slug": "pigeonsub",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pigeonsub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pigeonsub.app"
    },
    "android": {
      "package": "com.pigeonsub.app",
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6226FB",
          "dark": {
            "backgroundColor": "#6226FB"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow PigeonSub to use Face ID to secure your account."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez PigeonSub à joindre vos photos, reçus et confirmations à vos abonnements.",
          "cameraPermission": "Autorisez PigeonSub à photographier vos reçus et justificatifs."
        }
      ],
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "REPLACE_WITH_YOUR_BACKEND_URL"
    }
  }
}
