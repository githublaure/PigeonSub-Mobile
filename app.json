{
  "expo": {
    "name": "PigeonSub",
    "slug": "pigeonsub",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pigeonsub",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pigeonsub.app"
    },
    "android": {
      "package": "com.pigeonsub.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED"
      }
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#6226FB",
      "translucent": true
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#6226FB",
      "enforceContrast": false
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6226FB",
          "dark": {
            "backgroundColor": "#6226FB"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow PigeonSub to use Face ID to secure your account."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PigeonSub to access your photos to attach receipts.",
          "cameraPermission": "Allow PigeonSub to use the camera to capture receipts."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "REPLACE_WITH_YOUR_BACKEND_URL"
    }
  }
}
